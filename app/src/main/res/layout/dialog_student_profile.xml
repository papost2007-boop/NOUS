<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- ScrollView για να σκρολάρουν τα στοιχεία αν η οθόνη είναι μικρή -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Όνομα Μαθητή -->
            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ονοματεπώνυμο Μαθητή"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Τάξη & Κατεύθυνση -->
            <TextView
                android:id="@+id/tvProfileGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Τάξη: Γ' Λυκείου"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Πλαίσιο Στοιχείων (Δίδακτρα & Υλικό) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#1E293B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <!-- 1. ΑΡΙΣΤΕΡΑ: Μηνιαία Δίδακτρα -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Μηνιαία Δίδακτρα"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvProfileFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 €"
                        android:textColor="#38BDF8"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. ΔΕΞΙΑ: Κουμπί Εποπτικού Υλικού -->
                <LinearLayout
                    android:id="@+id/btnMaterialsAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_btn_materials_unpaid"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Εποπτικό Υλικό"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvProfileMaterial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Εκκρεμεί"
                            android:textColor="#F59E0B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMaterialsArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="💳 ›"
                        android:textColor="#F59E0B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Τίτλος Πλέγματος Μηνών -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Κατάσταση Μηνιαίων Πληρωμών:"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Πλέγμα 11 Μηνών -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4"
                android:layout_marginBottom="16dp">

                <Button android:id="@+id/btnMonthSep" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Σεπτέμβριος"/>
                <Button android:id="@+id/btnMonthOct" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Οκτώβριος"/>
                <Button android:id="@+id/btnMonthNov" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Νοέμβριος"/>
                <Button android:id="@+id/btnMonthDec" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Δεκέμβριος"/>
                <Button android:id="@+id/btnMonthJan" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Ιανουάριος"/>
                <Button android:id="@+id/btnMonthFeb" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Φεβρουάριος"/>
                <Button android:id="@+id/btnMonthMar" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Μάρτιος"/>
                <Button android:id="@+id/btnMonthApr" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Απρίλιος"/>
                <Button android:id="@+id/btnMonthMay" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Μάιος"/>
                <Button android:id="@+id/btnMonthJun" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Ιούνιος"/>
                <Button android:id="@+id/btnMonthJul" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:textSize="11sp" android:text="Ιούλιος"/>
            </GridLayout>

            <!-- Κουμπιά Ιστορικού & Σημειώσεων σε οριζόντια διάταξη -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnProfileHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📜 ΙΣΤΟΡΙΚΟ"
                    android:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnProfileNotes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📝 ΣΗΜΕΙΩΣΕΙΣ"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Κουμπί Κλεισίματος (Πάντα σταθερό & ορατό στο κάτω μέρος) -->
    <Button
        android:id="@+id/btnProfileClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ΚΛΕΙΣΙΜΟ"
        android:backgroundTint="#334155"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

</LinearLayout>