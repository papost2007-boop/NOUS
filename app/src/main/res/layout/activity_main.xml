<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/app_logo"
                android:scaleType="centerInside"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ΝΟΥΣ"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Σύστημα Διαχείρισης Φροντιστηρίου"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 💰 ENOTHTA 1: ΟΙΚΟΝΟΜΙΚΑ & ΤΑΜΕΙΟ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰  ΟΙΚΟΝΟΜΙΚΑ &amp; ΤΑΜΕΙΟ"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- HERO BUTTON: Γρήγορη Πληρωμή -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickPay"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="⚡   ΓΡΗΓΟΡΗ ΠΛΗΡΩΜΗ"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F59E0B"
                app:cornerRadius="12dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <!-- 2 Κουμπιά: Ημερήσιο Ταμείο & Οφειλέτες -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTodayPayments"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="📋  Ημερήσιο\nΤαμείο"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0284C7"
                    app:cornerRadius="12dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnpaidStudents"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="⚠️  Οφειλέτες\nΜήνα"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#DC2626"
                    app:cornerRadius="12dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 👥 ENOTHTA 2: ΔΙΑΧΕΙΡΙΣΗ ΜΑΘΗΤΩΝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥  ΔΙΑΧΕΙΡΙΣΗ ΜΑΘΗΤΩΝ"
                android:textColor="#A855F7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStudentList"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="👥\nΜαθητές"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#7C3AED"
                    app:cornerRadius="12dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterStudent"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:text="➕\nΕγγραφή"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    app:cornerRadius="12dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditStudents"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="✏️\nΕπεξεργασία"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#475569"
                    app:cornerRadius="12dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 📊 ENOTHTA 3: ΣΤΑΤΙΣΤΙΚΑ & ΡΥΘΜΙΣΕΙΣ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatistics"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📊   Στατιστικά"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D97706"
                app:cornerRadius="12dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="⚙️   Ρυθμίσεις"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                app:cornerRadius="12dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ✍️ Υπογραφή -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Created by Apo7."
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end"
            android:paddingEnd="8dp"/>

    </LinearLayout>
</ScrollView>