<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- 1. HEADER / Τίτλος Οθόνης -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 Ημερήσιο Ταμείο"
        android:textColor="#10B981"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <!-- 2. ΜΠΑΡΑ ΕΠΙΛΟΓΗΣ ΗΜΕΡΟΜΗΝΙΑΣ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E293B"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnPrevDay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="◄"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25/07/2026"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnNextDay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="►"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDailyTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_selected"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Σύνολο Ημέρας:"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDailyTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 €"
            android:textColor="#10B981"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTodayPayments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 4. ΚΟΥΜΠΙ: Εκτύπωση / Αποθήκευση PDF -->
    <Button
        android:id="@+id/btnPrintTodayPayments"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text=" ΕΚΤΥΠΩΣΗ "
        android:textColor="#FFFFFF"
        android:backgroundTint="#0284C7"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- 5. ΚΟΥΜΠΙ: Επιστροφή στο Dashboard -->
    <Button
        android:id="@+id/btnBackToMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text=" ΕΠΙΣΤΡΟΦΗ "
        android:textColor="#0F172A"
        android:backgroundTint="#E2E8F0"
        android:textSize="14sp"
        android:textStyle="bold"/>

</LinearLayout>