<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#0F172A">

    <!-- Αριστερό Μέρος (Σχόλια, Ημερομηνία και Μέθοδος Πληρωμής) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvItemComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Δίδακτρα"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09/07/2026"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <!-- 🎯 Αλλάξαμε το ID σε tvItemMethod για να ταιριάζει 100% με τη Java -->
            <TextView
                android:id="@+id/tvItemMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Μετρητά"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Δεξί Μέρος: Ποσό Πληρωμής -->
    <TextView
        android:id="@+id/tvItemAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+120.00 €"
        android:textColor="#10B981"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>