<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Τίτλος -->
    <TextView
        android:id="@+id/tvBookDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📚 Πληρωμή Εποπτικού Υλικού"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBookDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Μαθητής: -"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#334155" />

    <!-- 1. Συνολική Αξία -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Συνολική αξία (€)"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etBookAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1E293B"
        android:hint="π.χ. 40.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="#10B981"
        android:textColorHint="#64748B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 2. Επιλογή: Πλήρης ή Μερική Εξόφληση -->
    <RadioGroup
        android:id="@+id/rgPaymentType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbFullPayment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#10B981"
            android:checked="true"
            android:text="Πλήρης εξόφληση"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbPartialPayment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#F59E0B"
            android:text="Μερική πληρωμή"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- 3. Κρυφό πεδίο: Εμφανίζεται ΜΟΝΟ αν επιλεγεί η Μερική Πληρωμή -->
    <LinearLayout
        android:id="@+id/llPartialContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ποσό που δίνει τώρα (€)"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPartialAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="#1E293B"
            android:hint="π.χ. 20.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 4. Ημερομηνία Καταβολής -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ημερομηνία Καταβολής"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <RelativeLayout
        android:id="@+id/rlBookDateContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1E293B"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvBookPaymentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="02/09/2026"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="🗓️"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- 5. Τρόπος Πληρωμής -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Τρόπος Πληρωμής"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spBookPaymentMethod"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1E293B"
        android:paddingHorizontal="8dp" />

    <!-- Κουμπιά -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelBookDialog"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#334155"
            android:text="ΑΚΥΡΩΣΗ"
            android:textColor="#CBD5E1" />

        <Button
            android:id="@+id/btnSaveBookPayment"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#10B981"
            android:text="ΚΑΤΑΧΩΡΗΣΗ"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>