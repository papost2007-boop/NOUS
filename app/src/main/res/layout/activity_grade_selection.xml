<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Header / Τίτλος -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓 Επιλογή Τάξης"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Επιλέξτε τάξη για προβολή μαθητών"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- 🔍 ΜΠΑΡΑ ΑΝΑΖΗΤΗΣΗΣ ΜΑΘΗΤΗ -->
        <EditText
            android:id="@+id/etSearchStudent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="🔍 Αναζήτηση μαθητή..."
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:drawablePadding="8dp"
            android:textSize="15sp"
            android:inputType="textPersonName"
            android:imeOptions="actionSearch"
            android:layout_marginBottom="24dp"/>

        <!-- ΚΑΤΗΓΟΡΙΑ: ΓΥΜΝΑΣΙΟ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔹 ΓΥΜΝΑΣΙΟ"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btnGradeA_Gym"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Α' Γυμνασίου"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGradeB_Gym"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Β' Γυμνασίου"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGradeC_Gym"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Γ' Γυμνασίου"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>

        <!-- ΚΑΤΗΓΟΡΙΑ: ΛΥΚΕΙΟ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔮 ΛΥΚΕΙΟ"
            android:textColor="#8B5CF6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btnGradeA_Lyk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Α' Λυκείου"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B5CF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGradeB_Lyk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Β' Λυκείου"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B5CF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGradeC_Lyk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Γ' Λυκείου"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B5CF6"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="28dp"/>

        <!-- ΔΙΑΧΩΡΙΣΤΙΚΟ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginBottom="20dp"/>

        <!-- ΚΟΥΜΠΙ: ΠΡΟΒΟΛΗ ΟΛΩΝ -->
        <Button
            android:id="@+id/btnGradeAll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="👥   Προβολή Όλων των Μαθητών"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"/>

        <!-- ΚΟΥΜΠΙ: ΕΠΙΣΤΡΟΦΗ -->
        <Button
            android:id="@+id/btnGradeBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🚪   Επιστροφή στο Μενού"
            android:textColor="#FFFFFF"
            android:backgroundTint="#475569"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>