<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="#0F172A"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:elevation="2dp"
    android:gravity="center_vertical">

    <!-- 1. Κυκλικό Avatar με τα Αρχικά του Μαθητή -->
    <TextView
        android:id="@+id/tvStudentInitials"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/shape_circle"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="KA"
        android:layout_marginEnd="14dp"/>

    <!-- 2. Στοιχεία Μαθητή (Όνομα, Επίθετο & Τάξη) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvStudentFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Παπαδόπουλος Γιάννης"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStudentGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Γ' Λυκείου"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Δεξιά Πλευρά: Μηνιαία Δίδακτρα (€) -->
    <TextView
        android:id="@+id/tvStudentFee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120.00 €"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>